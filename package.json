{
  "name": "maniny",
  "version": "0.2.0",
  "description": "MANINY DIGITAL — CLI security scanner, hybrid chain correlator, attack report & multi-agent JSON output tool",
  "type": "module",
  "bin": {
    "maniny": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/runner.js",
    "./types": "./dist/types.js",
    "./exploit-chain-verifier": "./dist/core/exploit-chain-verifier.js",
    "./deduplicator": "./dist/utils/deduplicator.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/cli.js",
    "dev": "tsc -p tsconfig.json && node ./dist/cli.js",
    "test": "npm run build && node ./scripts/smoke-test.mjs && node ./scripts/test-hybrid-chains.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "cli",
    "security",
    "offensive-security",
    "exploit-chain",
    "vulnerability-scanner",
    "typescript"
  ],
  "license": "MIT"
}
