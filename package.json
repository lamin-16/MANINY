{
  "name": "maniny",
  "version": "0.3.0",
  "description": "MANINY DIGITAL \u2014 CLI security scanner, hybrid chain correlator, attack report & multi-agent JSON output tool",
  "type": "module",
  "bin": {
    "maniny": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/runner.js",
    "./types": "./dist/types.js",
    "./exploit-chain-verifier": "./dist/core/exploit-chain-verifier.js",
    "./deduplicator": "./dist/utils/deduplicator.js",
    "./session-manager": "./dist/core/session-manager.js",
    "./rate-limiter": "./dist/core/rate-limiter.js",
    "./tech-fingerprinter": "./dist/core/tech-fingerprinter.js",
    "./jwt-analyzer": "./dist/core/jwt-analyzer.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/cli.js",
    "test": "npm run build && node ./scripts/smoke-test.mjs && node ./scripts/test-hybrid-chains.mjs && node ./scripts/test-new-modules.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "cli",
    "security",
    "offensive-security",
    "exploit-chain",
    "vulnerability-scanner",
    "typescript",
    "bug-bounty",
    "termux"
  ],
  "license": "MIT"
}